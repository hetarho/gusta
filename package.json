{
  "name": "@haeram/gusta",
  "version": "0.17.1",
  "description": "A Spec-Driven Development (SDD) framework for code curators — Cultivate and exhibit your taste.",
  "type": "module",
  "bin": {
    "gusta": "bin/gusta.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "validate": "node ./bin/gusta.mjs validate --allow-empty",
    "pack:check": "node ./scripts/assert-pack.mjs",
    "check": "npm test && npm run validate && npm run pack:check",
    "release:check": "npm test && node ./bin/gusta.mjs validate && npm run pack:check",
    "prepublishOnly": "npm run release:check"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hetarho/gusta.git"
  },
  "bugs": {
    "url": "https://github.com/hetarho/gusta/issues"
  },
  "homepage": "https://github.com/hetarho/gusta#readme",
  "keywords": [
    "gusta",
    "spec-driven-development",
    "sdd",
    "agent-skills",
    "claude",
    "codex"
  ],
  "license": "MIT"
}
